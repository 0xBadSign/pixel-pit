{
  "name": "pixel-pit-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "abi": "node scripts/gen-abi.mjs",
    "abi:check": "node scripts/gen-abi.mjs --check",
    "dev-deployment": "node scripts/write-dev-deployment.mjs",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "smoke": "vite-node --options.define.__PIT_DEV__=false scripts/smoke-live.ts",
    "release:check": "node scripts/release-check.mjs",
    "release": "npm run typecheck && npm run build && node scripts/release-check.mjs"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
